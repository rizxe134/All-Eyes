# Optional. All Eyes runs with none of these set.
# The in-app CFG panel stores the same values in this browser.
# For the Mac app you can also put this file in Application Support.

# OpenSky OAuth client. Higher aircraft quota.
# https://opensky-network.org
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# NASA FIRMS map key. Adds fire hotspots on top of keyless EONET events.
# https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# Optional live traffic speed. The page still simulates vehicles on OpenStreetMap roads.
# MapTiler and Mapbox tokens are typed into CFG. They are not read from this file.
TOMTOM_KEY=
HERE_API_KEY=

# Optional camera catalogs. The globe still loads keyless road cameras with these empty.
WINDY_KEY=
WSDOT_KEY=
OHGO_KEY=

# Optional news and quote providers. Headlines and keyless quotes still load with these empty.
# NewsAPI, GNews, Finnhub, Twelve Data, Alpha Vantage, Polygon, and FMP are typed into CFG.
