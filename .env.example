# Optional. All Eyes runs with none of these set.
# The in-app CFG panel stores the same values in this browser.
# For the Mac app you can also put this file in Application Support.

# OpenSky OAuth client. Higher aircraft quota.
# https://opensky-network.org
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# NASA FIRMS map key. Adds fire hotspots on top of keyless EONET events.
# https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=
